{
  "name": "dsh-purge",
  "version": "1.1.91",
  "description": "Safe Edition for DeepSeek Harness: local configuration hygiene, reversible patches, and compatibility safeguards.",
  "author": "dsh-purge maintainers",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "safe-edition",
    "local-configuration",
    "reversible-patches",
    "compatibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2570825402-code/dsh-purge.git"
  },
  "homepage": "https://github.com/a2570825402-code/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/a2570825402-code/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/a2570825402-code/dsh-purge/tar.gz/refs/heads/safe-edition",
      "zip": "https://codeload.github.com/a2570825402-code/dsh-purge/zip/refs/heads/safe-edition",
      "git": "https://github.com/a2570825402-code/dsh-purge.git"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "dshTarget": "0.2.1-rc.5",
  "dshTargets": [
    "0.2.1-rc.5"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
